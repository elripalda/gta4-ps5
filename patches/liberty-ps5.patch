@@ -151,13 +151,21 @@ function(rexglue_apply_target_settings target_name)
 
     if(UNIX AND NOT APPLE)
         # Large executable support
-        if(_rexglue_target_processor MATCHES "x86_64|AMD64")
+        if(PS5)
