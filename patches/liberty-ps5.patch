diff --git a/glue/rexglue-sdk-main/cmake/rexglue_helpers.cmake b/glue/rexglue-sdk-main/cmake/rexglue_helpers.cmake
index 9ffeffdf..1f19e16d 100644
--- a/glue/rexglue-sdk-main/cmake/rexglue_helpers.cmake
