+// [ps5 port] see rex/ps5_diag.h
+#include <rex/ps5_diag.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
