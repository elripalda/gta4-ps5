+Fonts GetFonts() {
+  Fonts f;
+#if defined(__PROSPERO__)
+  f.body = hub::Fonts().body, f.bold = hub::Fonts().body_bold;
+#endif
+  if (!f.body) f.body = ImGui::GetFont();
+  if (!f.bold) f.bold = f.body;
+  return f;
+}
