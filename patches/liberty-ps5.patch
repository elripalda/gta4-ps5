+                  slot.largest.exchange(0, std::memory_order_relaxed)};
+    if (row.calls) rows.push_back(row);
+  }
+  std::sort(rows.begin(), rows.end(), [](const Row& a, const Row& b) { return a.bytes > b.bytes; });
