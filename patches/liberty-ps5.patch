+// Eight 32-byte pieces spread over the texture's memory: a different texture
+// in the same place differs in all of them.
+uint64_t Gta4NativeGraphicsSystem::ProbeGuestTexture(uint32_t address, uint32_t size) const {
+  const uint8_t* bytes = memory_ ? memory_->TranslatePhysical<const uint8_t*>(address) : nullptr;
+  if (!bytes || !size) return 0;
+  constexpr uint32_t kPiece = 32, kPieces = 8;
+  if (size <= kPiece * kPieces) return XXH3_64bits(bytes, size);
+  std::array<uint8_t, kPiece * kPieces> sample;
+  const uint32_t step = ((size - kPiece) / (kPieces - 1)) & ~(kPiece - 1);
+  for (uint32_t i = 0; i < kPieces; ++i) std::memcpy(sample.data() + i * kPiece, bytes + i * step, kPiece);
+  return XXH3_64bits(sample.data(), sample.size());
+}
+
+// Called with texture_resource_mutex_ held, for a new guest-memory capture.
+void Gta4NativeGraphicsSystem::WatchTexture(const std::shared_ptr<const NativeTextureResource>& resource) {
+  if (!REXCVAR_GET(gta4_native_texture_watch) || REXCVAR_GET(protect_on_release)) return;
+  const TextureInfo& info = resource->info;
+  // The memory read for the largest level captured.
+  const bool base = info.mip_min_level == 0 && info.memory.base_size;
+  const uint32_t address = base ? info.memory.base_address : info.memory.mip_address;
+  const uint32_t size = base ? info.memory.base_size : info.memory.mip_size;
+  if (!address || !size) return;
+  WatchedTexture watched;
+  watched.resource = resource;
+  watched.handle = resource->handle;
+  watched.generation = resource->generation;
+  watched.address = address;
+  watched.size = size;
+  watched.probe = ProbeGuestTexture(address, size);
+  std::lock_guard lock(texture_watch_mutex_);
+  if (texture_watch_stop_) return;
+  texture_watch_added_.push_back(std::move(watched));
+  if (!texture_watch_thread_.joinable())
+    texture_watch_thread_ = std::thread([this] { TextureWatchMain(); });
+}
+
+void Gta4NativeGraphicsSystem::TextureWatchMain() {
+  std::vector<WatchedTexture> watched;
+  std::vector<ChangedTexture> changed;
+  // [ps5 port] Off the renderer threads' cores (it was started from the game's
+  // render thread and would otherwise share its CPU).
+  uint64_t cpus_applied = UINT64_MAX;
+  std::unique_lock lock(texture_watch_mutex_);
+  while (!texture_watch_stop_) {
+    rex::frame_stats::FollowRendererCpuMask(cpus_applied, rex::frame_stats::RendererRole::kOther);
+    // Ten passes a second (a pass over a few thousand textures reads ~1 MB):
+    // the map's tiles, streamed in where others were as it zooms, are wrong
+    // for a moment at most.
+    texture_watch_condition_.wait_for(lock, std::chrono::milliseconds(100),
+                                      [this] { return texture_watch_stop_; });
+    if (texture_watch_stop_) break;
+    for (WatchedTexture& added : texture_watch_added_) watched.push_back(std::move(added));
+    texture_watch_added_.clear();
+    lock.unlock();
+    changed.clear();
+    size_t kept = 0;
+    for (size_t i = 0; i < watched.size(); ++i) {
+      WatchedTexture& entry = watched[i];
+      // Gone from the cache and from every queued frame: nothing to correct.
+      if (entry.resource.expired()) continue;
+      const uint64_t probe = ProbeGuestTexture(entry.address, entry.size);
+      if (probe != entry.probe) {
+        entry.probe = probe;
+        changed.push_back({entry.handle, entry.generation});
+      }
+      if (kept != i) watched[kept] = std::move(entry);
+      ++kept;
+    }
+    watched.resize(kept);
+    lock.lock();
+    if (!changed.empty()) {
+      // (once each, however many passes ran before the next present)
+      texture_watch_changed_.insert(texture_watch_changed_.end(), changed.begin(), changed.end());
+      std::sort(texture_watch_changed_.begin(), texture_watch_changed_.end());
+      texture_watch_changed_.erase(std::unique(texture_watch_changed_.begin(), texture_watch_changed_.end()),
+                                   texture_watch_changed_.end());
+      texture_watch_changed_pending_.store(true, std::memory_order_release);
+    }
+  }
+}
+
+// The producer, once a frame: the next capture of each changed texture takes
+// the full path, which re-reads it and keeps the cached image if it matches.
+void Gta4NativeGraphicsSystem::TakeChangedTextures() {
+  if (!texture_watch_changed_pending_.load(std::memory_order_acquire)) return;
+  std::vector<ChangedTexture> changed;
+  {
+    std::lock_guard lock(texture_watch_mutex_);
+    changed.swap(texture_watch_changed_);
+    texture_watch_changed_pending_.store(false, std::memory_order_relaxed);
+  }
+  if (changed.empty()) return;
+  std::lock_guard lock(texture_resource_mutex_);
+  uint64_t marked = 0;
+  for (const ChangedTexture& change : changed) {
+    // Only the capture that was watched, still current and still guest-owned
+    // (not since replaced, nor turned into a resolve target).
+    const auto current = texture_resources_.find(change.handle);
+    if (current == texture_resources_.end() || !current->second ||
+        current->second->generation != change.generation || current->second->gpu_produced)
+      continue;
+    dirty_texture_handles_.insert(change.handle);
+    ForgetTextureCapture(change.handle);
+    ++marked;
+  }
+  texture_watch_changes_.fetch_add(marked, std::memory_order_relaxed);
+}
+
+void Gta4NativeGraphicsSystem::StopTextureWatch() {
+  {
+    std::lock_guard lock(texture_watch_mutex_);
+    texture_watch_stop_ = true;
+  }
+  texture_watch_condition_.notify_all();
+  if (texture_watch_thread_.joinable()) texture_watch_thread_.join();
+}
