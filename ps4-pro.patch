 {
-    s_memLength = HEAP_TOTAL
+    s_memLength = Ps4DirectMemoryCeiling()
                   - RESERVE_TLS
                   - RESERVE_RAZOR
                   - RESERVE_SAVES
@@ -49,7 +67,7 @@ extern "C" int user_malloc_init(void)
