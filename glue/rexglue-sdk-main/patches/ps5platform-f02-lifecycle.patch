 int
+ps5_shm_unmap_reported(void *view, size_t bytes, unsigned flags, struct ps5_shm_unmap_report *report)
+{
+   if (!report)
+      return PS5_SHM_BAD_REQUEST;
+   memset(report, 0, sizeof(*report));
+   report->unmap_result = PS5_SHM_BAD_REQUEST;
+   if (!view || bytes == 0)
+      return PS5_SHM_BAD_REQUEST;
+   const int32_t unmapped = sceKernelMunmap(view, bytes);
+   if (report)
+      report->unmap_result = unmapped;
+   if (unmapped != 0)
+      return unmapped;
+   atomic_fetch_sub(&views, 1);
+   atomic_fetch_sub(&view_bytes, bytes);
+   if (flags & PS5_SHM_KEEP_RESERVED) {
+      void *at = view;
+      const int32_t reserved = sceKernelReserveVirtualRange(&at, bytes, PS5_KERNEL_MAP_FIXED,
+                                                            PS5P_PAGE);
+      if (report) {
+         report->reserved = 1;
+         report->reserve_result = reserved;
+         report->reserve_address = at;
+      }
+      if (reserved == 0 && at != view) {
+         sceKernelMunmap(at, bytes);
+         if (report)
+            report->reserve_result = PS5_SHM_NO_PLACE;
+         return PS5_SHM_NO_PLACE;
+      }
+      return reserved;
+   }
+   return 0;
+}
+
+int
+ps5_shm_destroy_reported(struct ps5_shm *shm)
+{
+   if (!shm)
+      return PS5_SHM_BAD_REQUEST;
+   if (shm->bytes == 0)
+      return 0;
+   const int32_t result = sceKernelReleaseDirectMemory(shm->direct_start, shm->bytes);
+   if (result != 0)
+      return result;
+   atomic_fetch_sub(&objects, 1);
+   atomic_fetch_sub(&object_bytes, shm->bytes);
+   memset(shm, 0, sizeof(*shm));
+   return 0;
+}
