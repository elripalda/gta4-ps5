+/* [F02 diagnostic] The steps ps5_shm_unmap performs, reported separately, so a
+ * caller can tell a failed unmap from a failed re-reservation. Behaviour and
+ * accounting are those of ps5_shm_unmap. */
+struct ps5_shm_unmap_report {
+   int unmap_result;      /* sceKernelMunmap's result */
+   int reserve_result;    /* 0 when no reservation was requested */
+   void *reserve_address; /* the address the re-reservation returned */
+   unsigned reserved;     /* non-zero: a re-reservation was requested */
+};
+int ps5_shm_unmap_reported(void *view, size_t bytes, unsigned flags,
+                           struct ps5_shm_unmap_report *report);
+
+/* Failed release retains the descriptor and live counters; an empty descriptor is a no-op. */
+int ps5_shm_destroy_reported(struct ps5_shm *shm);
+
 /* A reserved range: address space nothing else is given, outside the GPU
